{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ForjaDb": "Host=localhost;Port=5432;Database=forja;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "forja-api",
    "Audience": "forja-app",
    "Key": "CHANGE_ME_use_a_long_random_secret_key_at_least_32_bytes_long_dev_only",
    "ExpiryHours": 12
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
